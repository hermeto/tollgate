{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hermeto/tollgate/schemas/models.schema.json",
  "title": "Tollgate logical models",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "base_url"],
      "properties": {
        "provider": { "enum": ["openai", "anthropic"] },
        "model": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string", "format": "uri", "minLength": 1 }
      }
    }
  }
}
